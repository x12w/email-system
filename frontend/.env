# ============================================================
# 环境变量配置（Vite）
# 所有以 VITE_ 开头的变量会被注入到 import.meta.env 中，
# 可在运行时通过 import.meta.env.VITE_xxx 访问。
# ============================================================

# 后端 API 基础地址，所有 API 请求会拼接在此路径之后。
# 开发环境默认指向本地后端服务，生产环境部署时替换为实际地址。
VITE_API_BASE_URL=http://localhost:8080/api

# 开发模式绕过登录认证。
# true  - 跳过登录流程，自动注入模拟 token 和用户数据，方便后端未就绪时进行前端开发。
# false - 恢复正常的登录认证流程。
# 注意：生产环境打包时务必设为 false 或移除此变量。
VITE_DEV_BYPASS_AUTH=false
