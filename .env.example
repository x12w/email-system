# ============================================
# Email System — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# Required: JWT_SECRET (at least 32 random characters)
# Optional: INIT_ADMIN_PASSWORD (creates an initial admin user on first startup)

MYSQL_DATABASE=email_system
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=email_user
MYSQL_PASSWORD=email_password
MYSQL_ROOT_PASSWORD=root_password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# IMPORTANT: Generate a strong random secret (>=32 characters).
# Example: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRE_SECONDS=7200

# Optional: Set to create the initial admin user on first startup.
# If left blank, use the /auth/register endpoint to create the first user.
INIT_ADMIN_PASSWORD=

STORAGE_TYPE=minio
STORAGE_LOCAL_ROOT_PATH=/app/data/uploads
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=email-system

MAIL_HOST=mailpit
MAIL_PORT=1025

INTELLIGENCE_LLM_ENABLED=true
INTELLIGENCE_LLM_BASE_URL=http://localhost:11434/v1
INTELLIGENCE_LLM_API_KEY=ollama
INTELLIGENCE_LLM_MODEL=qwen2.5:7b
INTELLIGENCE_LLM_TIMEOUT_SECONDS=30

# IMAP fetch count per sync
IMAP_FETCH_COUNT=50

# CORS: comma-separated allowed origins (required for allowCredentials=true)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Rate limiting for auth endpoints
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
